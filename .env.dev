# build mode
NODE_ENV=development

# development server port
SERVE_PORT=8230

# content files
CONTENT_DIR=./src/content/

# template files
TEMPLATE_DIR=./src/template/
TEMPLATE_DEFAULT=default.html
TEMPLATE_LIST=list.html
TEMPLATE_TAG=tag.html

# CSS entry
CSS_DIR="./src/css/main.css"

# JS entry
JS_DIR="./src/js/main.js"

# CSS and JS browser target
BROWSER_TARGET="chrome140,firefox140,safari18.6"

# build directory
BUILD_DIR=./build/
BUILD_ROOT=/

# data caching
API_URL="https://api.github.com/repos/craigbuckler/staticsearch"
API_CACHE=./_cache/
API_CACHE_MINS=60

# site details
SITE_LANGUAGE="en-US"
SITE_DOMAIN="https://staticsearch.com"
SITE_VERSION="1.0.0"
SITE_TITLE="StaticSearch"
SITE_DESCRIPTION="superior search for static sites"
SITE_AUTHOR="Craig Buckler"
SITE_AUTHORURL="https://craigbuckler.com/"
SITE_AUTHORX="@craigbuckler"
SITE_WORDCOUNTSHOW=100
SITE_THEMECOLOR="#0a0c12"
